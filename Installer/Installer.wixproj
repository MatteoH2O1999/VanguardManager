<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>AssemblyVersion=$(AssemblyVersion)</DefineConstants>
    <Cultures>it-IT;en-US;es-ES;fr-FR;de-DE</Cultures>
    <Platform>x64</Platform>
    <OutDir>$(MSBuildThisFileDirectory)/../msi</OutDir>
    <SuppressPdbOutput>true</SuppressPdbOutput>
  </PropertyGroup>

  <ItemGroup>
    <None Include="license.rtf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Manager.Vanguard.Updater\Manager.Vanguard.Updater.csproj" Publish="True" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="dotnet run ./postbuild.cs" WorkingDirectory="$(MSBuildThisFileDirectory)/.." />
  </Target>

  <Target Name="CleanMSI" AfterTargets="Clean">
    <RemoveDir Directories="$(OutDir)" />
  </Target>
</Project>
